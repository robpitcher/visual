    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: var(--person-color);
  }

  .person::before {
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
  }

  .person::after {
    bottom: 0;
    width: 18px;
    height: 12px;
    border-radius: 12px 12px 2px 2px;
  }

  .person--0 {
    --person-color: var(--cc-0);
  }

  .person--1 {
    --person-color: var(--cc-2);
  }

  .person--2 {
    --person-color: var(--cc-1);
  }

  .arrow {
    width: 34px;
    height: 16px;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pool {
    display: grid;
    gap: 5px;
    width: 82px;
    padding: 5px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
  }

  .pool__row {
    display: block;
    border-radius: 3px;
  }

