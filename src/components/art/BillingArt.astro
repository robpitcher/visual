    background: linear-gradient(135deg, var(--cc-0), color-mix(in srgb, var(--cc-0) 72%, var(--accent-2)));
  }

  .pool__row--mid {
    height: 22px;
    background: linear-gradient(135deg, var(--cc-1), color-mix(in srgb, var(--cc-1) 66%, var(--accent)));
  }

  .pool__row--thin {
