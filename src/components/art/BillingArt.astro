<div class="billing-art" aria-hidden="true">
  <div class="people">
    {Array.from({ length: 6 }).map((_, index) => <span class={`person person--${index % 3}`}></span>)}
  </div>
  <svg class="arrow" viewBox="0 0 46 16">
    <path d="M1 8h35"></path>
    <path d="m30 2 8 6-8 6"></path>
  </svg>
  <div class="pool">
    <span class="pool__row pool__row--top"></span>
    <span class="pool__row pool__row--mid"></span>
    <span class="pool__row pool__row--thin"></span>
  </div>
</div>

<style>
  .billing-art {
    width: min(100%, 286px);
    height: 120px;
    display: grid;
